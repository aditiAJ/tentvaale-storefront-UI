# Where the backend is. The browser never sees this: next.config.ts forwards /api/* to it on the
# server side, so there is no CORS to configure and no API URL in the client bundle.
API_ORIGIN=http://localhost:8080

# Razorpay public key id (checkout.js). Filled in when payments are wired.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
