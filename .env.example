# Where the backend is. The browser never sees this: next.config.ts forwards /api/* to it on the
# server side, so there is no CORS to configure and no API URL in the client bundle.
API_ORIGIN=http://localhost:8080

# Razorpay public key id (checkout.js). Filled in when payments are wired.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Google Maps JavaScript + Places key for the venue picker. Leave empty: venues are then a name and an address only.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google OAuth client id (public) for "Continue with Google". Empty: email sign-in only.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
